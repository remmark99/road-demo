NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public production origin, without a trailing slash.
APP_BASE_URL=https://example.com

# Transactional email provider (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Use a freshly rotated token. Never reuse a token shared in chat or committed.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=

# Random secret used by Supabase pg_net/cron to invoke the dispatcher.
NOTIFICATION_DISPATCH_SECRET=
