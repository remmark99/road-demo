NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public production origin, without a trailing slash.
APP_BASE_URL=https://example.com

# Transactional email provider (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: where support requests from the in-app widget are delivered.
# Defaults to SMTP_FROM (the mailbox sends the request to itself) when unset.
SUPPORT_INBOX_EMAIL=

# Use a freshly rotated token. Never reuse a token shared in chat or committed.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=

# Random secret used by Supabase pg_net/cron to invoke the dispatcher.
NOTIFICATION_DISPATCH_SECRET=

# Basemap source. Default (unset or "local") serves the mirrored OpenFreeMap
# tiles from public/map — run `npm run map:fetch` once after deploy to fill it.
# Set to "remote" to fall back to tiles.openfreemap.org.
NEXT_PUBLIC_MAP_TILES=local

# Separate License DB Supabase. Server-only values; do not use NEXT_PUBLIC_.
LICENSE_DB_URL=
LICENSE_DB_SERVICE_ROLE_KEY=
# Explicit platform auth user UUID -> License DB customers.id UUID binding.
LICENSE_USER_CUSTOMERS={}

# Informational license inventory: License DB licenses.id -> explicit city/stop IDs.
# Does not change signed entitlements or the camera limit. Never infer from customer names.
# {"license-uuid":{"city":"surgut","stopIds":[42,162]}}
LICENSE_RESOURCE_SCOPES={}
